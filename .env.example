# ---------------------------------------------------------------------------
# Template for the local admin's .env file.
#
# Copy this to `.env` and fill in your own values:
#     cp .env.example .env
#
# `.env` holds real credentials and is gitignored - never commit it.
# (On Windows, Install.bat writes .env for you, so you can ignore this file.)
# ---------------------------------------------------------------------------

# --- TiDB Cloud (Starter) connection ---------------------------------------
# Find these in the TiDB console: your instance -> Connect
DB_HOST=your-tidb-host
DB_PORT=4000
DB_USER=your-tidb-user
DB_NAME=pos-water-station

# Password for the TiDB user above. Fill this in - do not commit it.
DB_PASS=

# --- TLS --------------------------------------------------------------------
# Path to the CA certificate downloaded from the TiDB console. Paths are
# resolved from the PROJECT FOLDER (not the current directory), so this works
# wherever the app is installed. The certificate ships in certs/ca.pem.
DB_CA=certs/ca.pem

# Serverless hosts (Netlify and friends) cannot receive a file, so they are
# given the certificate text in the DB_CA_CERT environment variable instead.
# See the README section "Deploying the customer site". For the local admin,
# leave DB_CA as the path above.

# Set to false only for local testing without TLS.
DB_SSL=true

# --- Owner account (created by `npm run db:init`) ---------------------------
# Leave OWNER_PASSWORD empty and a random one is generated and printed once
# during setup. Sign in with it, then change it in the admin.
OWNER_USERNAME=owner
OWNER_PASSWORD=

# --- Store identity (seeded into Settings, editable later in the admin) -----
BUSINESS_NAME=Water Station
# Set to false to skip the sample product rows during seeding.
SEED_PRODUCTS=true

# --- Local admin server -----------------------------------------------------
ADMIN_PORT=3000
# Any long random string. The Windows installer generates this for you.
SESSION_SECRET=

# --- Automatic backups ------------------------------------------------------
# Snapshots are written to backups/ (or BACKUP_DIR). A quiet shop never writes
# one: a backup happens only when something actually changed.
BACKUP_ENABLED=true
# Back up after this many transactions (order, payment, expense, customer).
BACKUP_EVERY_TRANSACTIONS=20
# ...or after this many minutes, whichever comes first.
BACKUP_INTERVAL_MINUTES=30
# How many snapshots to keep before the oldest are deleted.
BACKUP_KEEP=30
# Optional: put backups somewhere outside this folder, e.g. D:\POS Backups
# BACKUP_DIR=
