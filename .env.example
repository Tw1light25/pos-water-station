# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
# NEVER commit `.env` - it holds your database password.
# ---------------------------------------------------------------------------

# --- TiDB Cloud (Starter) connection ---------------------------------------
# Find these under: TiDB console -> your instance -> Connect
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your-prefix.root
DB_PASS=your-password
DB_NAME=pos-water-station

# TLS certificate downloaded from the TiDB console ("CA cert").
# Paths are resolved from the PROJECT FOLDER (not the current directory), so a
# relative path like this works no matter where the app is installed or launched.
# The certificate ships in ./certs/ca.pem.
DB_CA=certs/ca.pem
# Alternatively supply the PEM inline (useful on serverless hosts where you
# cannot ship a file). Use \n for newlines. Ignored when DB_CA resolves.
# DB_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Set to false only for local testing without TLS.
DB_SSL=true

# --- Owner account (created by `npm run db:init`) ---------------------------
# Leave OWNER_PASSWORD empty and a random one will be generated and printed
# once during setup. Log in with it, then change it in the admin.
OWNER_USERNAME=owner
OWNER_PASSWORD=

# --- Store identity (seeded into Settings, editable later in the admin) ----
BUSINESS_NAME=Water Station
# Set to false to skip the sample product rows during seeding.
SEED_PRODUCTS=true

# --- Local admin server (used from Step 2 onward) --------------------------
ADMIN_PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string
